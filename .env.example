# PayPal Webhook Configuration
# Get this from PayPal Developer Dashboard > Webhooks > Your Webhook > Webhook ID
PAYPAL_WEBHOOK_ID=wh_xxxxxxxxxxxxxxxxxxxx

# PayPal Client ID for JavaScript SDK (Smart Payment Buttons)
# Get from PayPal Developer Dashboard > My Apps & Credentials > Your App > Client ID
# For sandbox testing, use the sandbox Client ID
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# Optional: PayPal Client ID and Secret for API access (if using Orders API)
# PAYPAL_CLIENT_ID=your_client_id
# PAYPAL_CLIENT_SECRET=your_client_secret

# XAI API Key for AI valuation
XAI_API_KEY=your_xai_api_key

# Lovable API Key (if using Lovable's AI)
# LOVABLE_API_KEY=your_lovable_api_key